# Python bytecode and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments and build output
.venv/
venv/
build/
dist/
*.egg-info/

# Node dependencies for the host plugin
node_modules/

# Local memory databases and their write-ahead files
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Memory backups exported from the running system. They contain conversation
# text and local paths, so they stay on the machine that produced them.
dsh-memory-*.md

# Per-project work summary derived from the local memory database. dsh-memory
# rewrites it whenever work is recorded, so it stays out of version control.
DSH_MEMORY.md

# Local scratch output
.tmp_*
*.log

# Ad-hoc verification artifacts for the rail markup: written against the local
# build and not part of the plugin, so they stay out of history.
.verify-rail.cjs
.preview-rail.html
.preview-rail.png
.preview-react.js

# One-off repository repair backups (see git repair notes)
.git-repair-backup-*/
.git-repair-*/