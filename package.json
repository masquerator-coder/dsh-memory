{
  "name": "dsh-memory",
  "version": "3.0.0",
  "description": "Three-tier consolidating memory plugin for DeepSeek Harness: working/episodic/semantic layers, dual-signal heat (exponential decay + frequency), active forgetting, three-level recall. Minimal, single-purpose, zero-dependency.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "memory",
    "cordis",
    "episodic",
    "forgetting"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=1",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": ">=1"
  }
}
