{
  "name": "dsh-memory-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "DSH 记忆插件：把 memory_system 的长期记忆接入 DSH —— 系统提示词里的记忆锚点、会话采集，以及设置页里的摘要生成、画像与记忆编辑。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "tools.js",
    "client.js",
    "bridge.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [],
      "external": []
    }
  }
}
